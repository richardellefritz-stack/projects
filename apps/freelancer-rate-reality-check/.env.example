# Lemon Squeezy — set these in Netlify:
# Site settings → Environment variables
# Never commit real values. Never put these in calculator/js.

# API key from Lemon Squeezy → Settings → API
# Sent as Authorization: Bearer … when calling the License API.
LEMONSQUEEZY_API_KEY=

# Numeric IDs from your Lemon Squeezy store / product.
# At least one of STORE_ID or PRODUCT_ID is required (fail closed).
# Find them in the Lemon Squeezy dashboard URL or product settings.
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=

# Optional: restrict to a single variant.
# LEMONSQUEEZY_VARIANT_ID=
